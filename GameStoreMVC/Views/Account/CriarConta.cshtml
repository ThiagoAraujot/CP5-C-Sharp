@model RegisterViewModel
@{ ViewData["Title"] = "Criar Conta"; }

<div class="gs-auth-wrap">
    <div class="gs-auth-card">

        <div class="text-center mb-4">
            <h3 class="fw-bold">Criar Conta</h3>
            <p class="text-muted small mb-0">Junte-se à nossa comunidade gamer.</p>
        </div>

        <form asp-action="CriarConta" method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="alert alert-danger small py-2 mb-3"></div>

            <div class="mb-3">
                <label asp-for="Nome" class="form-label small text-muted">Nome</label>
                <input asp-for="Nome" class="form-control" placeholder="Seu nome completo" autocomplete="name" />
                <span asp-validation-for="Nome" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label small text-muted">E-mail</label>
                <input asp-for="Email" class="form-control" placeholder="seu@email.com" autocomplete="email" />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Senha" class="form-label small text-muted">Senha</label>
                <input asp-for="Senha" class="form-control" placeholder="Crie uma senha forte" autocomplete="new-password" />
                <span asp-validation-for="Senha" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="ConfirmacaoSenha" class="form-label small text-muted">Confirmação de Senha</label>
                <input asp-for="ConfirmacaoSenha" class="form-control" placeholder="Repita a senha" autocomplete="new-password" />
                <span asp-validation-for="ConfirmacaoSenha" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-success w-100 py-2">Finalizar Cadastro</button>
        </form>

        <div class="text-center mt-4">
            <p class="text-muted small mb-1">Já possui uma conta?</p>
            <a asp-action="Login" class="text-success fw-bold text-decoration-none">Fazer Login</a>
        </div>

    </div>
</div>
