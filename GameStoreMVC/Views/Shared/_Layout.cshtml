<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GameStore</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>

<nav class="navbar navbar-expand-lg navbar-dark gs-navbar px-3 px-md-4">
    <a class="navbar-brand fw-bold fs-5 me-3" asp-controller="Home" asp-action="Index">
        LOJA<span class="text-success">GAME</span>
    </a>
    <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navMain">
        <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navMain">
        <ul class="navbar-nav me-auto">
            <li class="nav-item">
                <a class="nav-link" asp-controller="Home" asp-action="Index">Home</a>
            </li>
            @if (User.IsInRole("Admin"))
            {
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Game" asp-action="Index">Gerenciar Games</a>
                </li>
            }
        </ul>
        <ul class="navbar-nav ms-auto">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <li class="nav-item d-flex align-items-center">
                    <span class="nav-link text-muted small">Olá, <strong class="text-white">@User.Identity.Name</strong></span>
                </li>
                <li class="nav-item">
                    <form asp-controller="Account" asp-action="Logout" method="post">
                        <button type="submit" class="btn btn-outline-secondary btn-sm my-1">Sair</button>
                    </form>
                </li>
            }
            else
            {
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Account" asp-action="Login">Login</a>
                </li>
            }
        </ul>
    </div>
</nav>

<main>
    @RenderBody()
</main>

<footer class="gs-footer py-5 mt-5">
    <div class="container">
        <div class="row g-4">
            <div class="col-lg-4 col-md-6">
                <h5 class="fw-bold mb-3">
                    <span class="text-white">GAME</span><span class="text-success">STORE</span>
                </h5>
                <p class="text-muted small">
                    Sua arena gamer definitiva. Os melhores títulos, as ofertas mais quentes
                    e a maior comunidade de jogadores você encontra aqui.
                </p>
            </div>
            <div class="col-lg-2 col-md-3 col-6">
                <h6 class="fw-bold text-white mb-3">LOJA</h6>
                <ul class="list-unstyled small">
                    <li><a href="#" class="text-muted text-decoration-none gs-footer-link">Todos os Games</a></li>
                    <li><a href="#" class="text-muted text-decoration-none gs-footer-link">Lançamentos</a></li>
                    <li><a href="#" class="text-muted text-decoration-none gs-footer-link">Promoções</a></li>
                </ul>
            </div>
            <div class="col-lg-2 col-md-3 col-6">
                <h6 class="fw-bold text-white mb-3">SUPORTE</h6>
                <ul class="list-unstyled small">
                    <li><a href="#" class="text-muted text-decoration-none gs-footer-link">Privacidade</a></li>
                    <li><a href="#" class="text-muted text-decoration-none gs-footer-link">Termos de Uso</a></li>
                    <li><a href="#" class="text-muted text-decoration-none gs-footer-link">Fale Conosco</a></li>
                </ul>
            </div>
            <div class="col-lg-4 col-md-6">
                <h6 class="fw-bold text-white mb-3">FIQUE POR DENTRO</h6>
                <p class="text-muted small mb-2">Receba cupons de desconto exclusivos!</p>
                <div class="input-group input-group-sm">
                    <input type="email" class="form-control gs-input" placeholder="Seu melhor e-mail" />
                    <button class="btn btn-success px-3" type="button">OK</button>
                </div>
            </div>
        </div>
        <hr class="border-secondary mt-4" />
        <p class="text-center text-muted small mb-0">
            © 2026 - GameStoreMVC. Todos os direitos reservados.
        </p>
    </div>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/jquery.validate.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@4.0.0/dist/jquery.validate.unobtrusive.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
