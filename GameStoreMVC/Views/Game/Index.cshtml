@model IEnumerable<Game>
@{ ViewData["Title"] = "Gerenciar Games"; }

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="fw-bold mb-0">Gerenciar Games</h4>
        <a asp-action="Criar" class="btn btn-success">+ Cadastrar Novo Jogo</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible py-2 small">
            @TempData["Success"]
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="text-center text-muted py-5">
            <p>Nenhum jogo cadastrado ainda.</p>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var game in Model)
            {
                <div class="col-sm-6 col-md-4 col-lg-3">
                    <div class="gs-card">
                        <img src="@game.UrlCapa" alt="@game.Nome"
                             onerror="this.src='https://placehold.co/300x180/1e1e1e/00c853?text=Game'" />
                        <div class="gs-card-body">
                            <div class="d-flex gap-1 mb-1">
                                <span class="badge bg-secondary" style="font-size:.68rem;">@game.Categoria</span>
                                @if (game.Destaque)
                                {
                                    <span class="badge bg-success" style="font-size:.68rem;">Destaque</span>
                                }
                            </div>
                            <h6 class="fw-bold mb-1" style="font-size:.9rem;">@game.Nome</h6>
                            <p class="gs-price mb-3">R$ @game.Preco.ToString("N2")</p>
                            <div class="d-flex gap-2 mt-auto">
                                <a asp-action="Editar" asp-route-id="@game.Id"
                                   class="btn btn-warning btn-sm flex-fill">Editar</a>
                                <form asp-action="Excluir" method="post" class="flex-fill m-0">
                                    <input type="hidden" name="id" value="@game.Id" />
                                    <button type="submit" class="btn btn-danger btn-sm w-100"
                                            onclick="return confirm('Excluir @Html.Raw(game.Nome.Replace("'","\\'")??"")?\nEssa ação não pode ser desfeita.')">
                                        Excluir
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
