@model GameViewModel
@{ ViewData["Title"] = "Cadastrar Novo Game"; }

<div class="gs-auth-wrap">
    <div class="gs-auth-card" style="max-width:520px;">

        <div class="text-center mb-4">
            <h3 class="fw-bold">Novo Game</h3>
            <p class="text-muted small mb-0">Adicione um novo título ao catálogo.</p>
        </div>

        <form asp-action="Criar" method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="alert alert-danger small py-2 mb-3"></div>

            <div class="mb-3">
                <label asp-for="Nome" class="form-label small text-muted"></label>
                <input asp-for="Nome" class="form-control" placeholder="Ex: The Legend of Zelda" />
                <span asp-validation-for="Nome" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="DescricaoCurta" class="form-label small text-muted"></label>
                <input asp-for="DescricaoCurta" class="form-control" placeholder="Breve descrição do jogo" />
                <span asp-validation-for="DescricaoCurta" class="text-danger small"></span>
            </div>

            <div class="row mb-3">
                <div class="col-6">
                    <label asp-for="Preco" class="form-label small text-muted"></label>
                    <input asp-for="Preco" type="number" step="0.01" min="0.01" class="form-control" placeholder="0,00" />
                    <span asp-validation-for="Preco" class="text-danger small"></span>
                </div>
                <div class="col-6">
                    <label asp-for="Categoria" class="form-label small text-muted"></label>
                    <select asp-for="Categoria" class="form-select">
                        <option value="">Selecione</option>
                        <option value="RPG">RPG</option>
                        <option value="Ação">Ação</option>
                        <option value="Corrida">Corrida</option>
                        <option value="Aventura">Aventura</option>
                    </select>
                    <span asp-validation-for="Categoria" class="text-danger small"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="UrlCapa" class="form-label small text-muted"></label>
                <input asp-for="UrlCapa" class="form-control" placeholder="https://..." />
                <span asp-validation-for="UrlCapa" class="text-danger small"></span>
            </div>

            <div class="mb-4 form-check">
                <input asp-for="Destaque" class="form-check-input" />
                <label asp-for="Destaque" class="form-check-label small text-muted"></label>
            </div>

            <div class="d-flex gap-3">
                <button type="submit" class="btn btn-success flex-fill py-2">Salvar Game</button>
                <a asp-action="Index" class="btn btn-outline-secondary flex-fill py-2">Voltar</a>
            </div>
        </form>

    </div>
</div>
